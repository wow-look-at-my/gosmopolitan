# This file contains the initial defaults for go command configuration.
# Values set by 'go env -w' and written to the user's go/env file override these.
# The environment overrides everything else.

# Use the Go module mirror and checksum database by default.
# See https://proxy.golang.org for details.
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org

# Always run this cosmo fork instead of auto-switching toolchains.
# Upstream defaults to GOTOOLCHAIN=auto, but a go.mod go/toolchain directive
# newer than this fork's (dev-style) version would then silently download an
# official Go toolchain and lose cosmo support. An explicit GOTOOLCHAIN
# environment variable or 'go env -w' still overrides this default.
GOTOOLCHAIN=local
